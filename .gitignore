# =============================================================================
# CAFREC — .gitignore
# =============================================================================

# -----------------------------------------------------------------------------
# Dataset: KuaiRand-Pure (raw + tarball)
# Never commit raw data. Download via Zenodo (see T1.1 notebook).
# -----------------------------------------------------------------------------
data/KuaiRand-Pure/
data/KuaiRand-Pure.tar.gz

# Processed artefacts written by T1.1 (large; regenerated by notebook)
data/logs_sessioned.parquet
data/session_features.parquet
data/cohort_labels.parquet

# Catch-all for any other large data files added later
data/*.parquet
data/*.csv
data/*.h5
data/*.hdf5
data/*.pkl
data/*.pickle
data/*.npy
data/*.npz
data/*.bin

# Keep the data/ directory itself in the repo
!data/.gitkeep

# -----------------------------------------------------------------------------
# Model checkpoints and training outputs
# -----------------------------------------------------------------------------
checkpoints/
outputs/
runs/
logs/
*.pt
*.pth
*.ckpt
*.safetensors

# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
.eggs/

# Virtual environments
.venv/
venv/
env/
.env/
ENV/

# Installer caches
pip-log.txt
pip-delete-this-directory.txt
.pip/

# -----------------------------------------------------------------------------
# Jupyter
# -----------------------------------------------------------------------------
.ipynb_checkpoints/
*.ipynb_checkpoints

# -----------------------------------------------------------------------------
# Environment / secrets
# -----------------------------------------------------------------------------
.env
.env.*
*.env
secrets.yaml
secrets.json
openai_key.txt
anthropic_key.txt

# -----------------------------------------------------------------------------
# OS artefacts
# -----------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# -----------------------------------------------------------------------------
# IDEs
# -----------------------------------------------------------------------------
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# -----------------------------------------------------------------------------
# LaTeX (dissertation / slides)
# -----------------------------------------------------------------------------
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.toc
*.lof
*.lot
*.nav
*.snm
*.vrb
*.bcf
*.run.xml
*.pdf

# Keep deliberately committed PDFs (e.g. submitted reports)
!reports/**/*.pdf
!dissertation/**/*.pdf